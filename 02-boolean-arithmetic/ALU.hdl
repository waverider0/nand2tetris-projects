/*
  input flags (these transformations are done in order):
  if (zx == 1): x = 0
  if (nx == 1): x = !x
  if (zy == 1): y = 0
  if (ny == 1): y = !y
  out = (f == 1) ? x+y : x&y
  if (no == 1): out = !out

  based on the 6 input flags, out = one of the following:
  101010 -> 0
  111111 -> 1
  111010 -> -1
  001100 -> x
  110000 -> y
  001101 -> !x
  110001 -> !y
  001111 -> -x
  110011 -> -y
  011111 -> x+1
  110111 -> y+1
  001110 -> x-1
  110010 -> y-1
  000010 -> x+y
  010011 -> x-y
  000111 -> y-x
  000000 -> x&y
  010101 -> x|y

  output flags:
  zr = (out == 0) ? 1 : 0
  ng = (out < 0) ? 1 : 0
*/
CHIP ALU {
  IN
    x[16], y[16],
    zx, nx, zy, ny, f, no;
  OUT
    out[16],
    zr, ng;

  PARTS:
}
