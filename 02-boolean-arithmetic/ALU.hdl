/*
  input flags (these transformations are done in order):
  if (zx == 1): x = 0
  if (nx == 1): x = !x
  if (zy == 1): y = 0
  if (ny == 1): y = !y
  out = (f == 1) ? x+y : x&y
  if (no == 1): out = !out

  based on the 6 input flags, out = one of the following:
  101010 -> 0
  111111 -> 1
  111010 -> -1
  001100 -> x
  110000 -> y
  001101 -> !x
  110001 -> !y
  001111 -> -x
  110011 -> -y
  011111 -> x+1
  110111 -> y+1
  001110 -> x-1
  110010 -> y-1
  000010 -> x+y
  010011 -> x-y
  000111 -> y-x
  000000 -> x&y
  010101 -> x|y

  output flags:
  zr = (out == 0) ? 1 : 0
  ng = (out < 0) ? 1 : 0
*/
CHIP ALU {
  IN
    x[16], y[16],
    zx, nx, zy, ny, f, no;
  OUT
    out[16],
    zr, ng;
  PARTS:
    Mux16(a=x, b=false, sel=zx, out=ZX);
    Mux16(a=y, b=false, sel=zy, out=ZY);
    Not16(in=ZX, out=notZX);
    Not16(in=ZY, out=notZY);
    Mux16(a=ZX, b=notZX, sel=nx, out=NX);
    Mux16(a=ZY, b=notZY, sel=ny, out=NY);
    And16(a=NX, b=NY, out=andNXNY);
    Add16(a=NX, b=NY, out=addNXNY);
    Mux16(a=andNXNY, b=addNXNY, sel=f, out=F);
    Not16(in=F, out=notF);
    Mux16(a=F, b=notF, sel=no, out=out, out[0..7]=outLow, out[8..15]=outHigh, out[15]=ng);
    Or8Way(in=outLow, out=orLow);
    Or8Way(in=outHigh, out=orHigh);
    Or(a=orLow, b=orHigh, out=orAll);
    Not(in=orAll, out=zr);
}